	if not root then return {} end
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and ValidPlayer(p) then
			local h, pos = GetHead(p)
			if h then table.insert(t, {Player = p, Head = h, Pos = pos, Dist = (pos - root.Position).Magnitude}) end
		end
	end
	table.sort(t, function(a, b) return a.Dist < b.Dist end)
	return t
end

local function createTrace(targetPos)
	local char = LP.Character
	if not (char and char.PrimaryPart) then return end
	local S = char.PrimaryPart.Position + Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
	local mag = (targetPos - S).Magnitude
	local P = Instance.new("Part")
	P.Name, P.Anchored, P.CanCollide, P.CastShadow = "Trace", true, false, false
	P.Material, P.Color, P.Size = Enum.Material.Neon, Color3.fromHSV(tick() % 1, 0.8, 1), Vector3.new(0.15, 0.15, mag)
	P.CFrame, P.Parent = CFrame.lookAt(S, targetPos) * CFrame.new(0, 0, -mag/2), Workspace
	TS:Create(P, TweenInfo.new(0.3), {Transparency = 1, Size = Vector3.new(0, 0, mag)}):Play()
	Debris:AddItem(P, 0.3)
end

local function Shoot(p, head, pos)
	if IsShooting then return end
	if tick() - LastShot < AttackCooldown then return end
	
	IsShooting = true
	
	local root = LP.Character:FindFirstChild("HumanoidRootPart")
	if not root then 
		IsShooting = false
		return 
	end
	
	createTrace(pos)
	local s = Instance.new("Sound", Workspace)
	s.SoundId, s.Volume = SoundCfg.Id, SoundCfg.Volume
	s:Play(); Debris:AddItem(s, 2)
	
	local t, cf = tick(), CFrame.lookAt(root.Position, pos)
	
	local actionSyncArgs = {
		{
			direction = vector.create(
				(pos - root.Position).Unit.X,
				(pos - root.Position).Unit.Y,
				(pos - root.Position).Unit.Z
			),
			hitPosition = vector.create(pos.X, pos.Y, pos.Z),
			origin = vector.create(root.Position.X, root.Position.Y + 2, root.Position.Z),
			hitInstance = head,
			hitHumanoid = p.Character:FindFirstChild("Humanoid"),
			IsHeadshot = (head.Name == "Head")
		}
	}
	
	local RS = game:GetService("ReplicatedStorage")
	pcall(function()
		RS:WaitForChild("SystemResources"):WaitForChild("BufferCache"):WaitForChild("RequestActionSync"):FireServer(unpack(actionSyncArgs))
	end)
	
	local randomDelay = math.random(-10, 10) / 100
	wait(0.05 + randomDelay)
	
	local fakeBulletArgs = {
		cf,
		vector.create(
			(pos - root.Position).Unit.X,
			(pos - root.Position).Unit.Y,
			(pos - root.Position).Unit.Z
		)
	}
	
	pcall(function()
		RS:WaitForChild("Events"):WaitForChild("RemoteEvents"):WaitForChild("ReplicateFakeBullet"):FireServer(unpack(fakeBulletArgs))
	end)
	
	wait(0.03)
	
	pcall(function()
		RS:WaitForChild("Events"):WaitForChild("RemoteEvents"):WaitForChild("CharacterMuzzleFlash"):FireServer()
	end)
	
	LastShot = t
	CurrentTarget = nil
	
	wait(0.1)
	IsShooting = false
end

RunService.Heartbeat:Connect(function()
	if fkrage then
		if IsShooting then return end
		
		if CurrentTarget and not ValidPlayer(CurrentTarget) then
			CurrentTarget = nil
		end
		
		local now = tick()
		if not CurrentTarget and (now - LastTargetSwitch) > TargetSwitchCooldown then
			LastTargetSwitch = now
			local t = VisibleTargets()
			CurrentTarget = t[1] and t[1].Player
		end
		
		if CurrentTarget and not IsShooting then
			local h, pos = GetHead(CurrentTarget)
			if h then 
				Shoot(CurrentTarget, h, pos)
			else
				CurrentTarget = nil
			end
		end
	end
end)

